# Local interpreters, packages and caches
/.venv/
/.cache/
/.tools/
__pycache__/
.pytest_cache/
*.py[cod]
/node_modules/
/.vitest/
/dist/
/.next/
/.netlify/
# Credentials and local-only editor/OS state
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.git-credentials
.DS_Store
Thumbs.db
Desktop.ini
*.log
# Machine-oriented JUnit records stay local; publish sanitized summaries instead.
/docs/**/vitest*.xml
/docs/**/pytest*.xml
/docs/**/antivirus*.json
/out/
*.tsbuildinfo
# Original scientific products are downloaded, not versioned.
/data/raw/
# Reproducible rasters; retain configuration, reports, hashes and previews.
/data/processed/**/*.tif
/data/processed/**/*.tif.aux.xml
/data/processed/**/*.npy
